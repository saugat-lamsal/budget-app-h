{
  "name": "budget-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run typecheck && vitest run",
    "test:slow": "node scripts/test-slow.mjs",
    "test:watch": "vitest",
    "test:sandbox": "vitest run --config packages/server/vitest.live.config.ts --silent=false",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "demo": "node scripts/demo.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "serve": "node scripts/serve.mjs",
    "replay-check": "node scripts/replay-check.mjs",
    "login-code": "node scripts/login-code.mjs",
    "push-keys": "node scripts/push-keys.mjs",
    "build": "node scripts/build.mjs",
    "litestream": "node scripts/litestream.mjs",
    "restore-check": "node scripts/restore-check.mjs",
    "pay-period-agent": "node scripts/pay-period-agent.mjs",
    "rehearsal": "node scripts/rehearsal.mjs",
    "deploy-check": "node scripts/deploy-check.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
